	</div>
</div>

<div id="website-content" class="relative">
	<button class="toggle-button fixed top-4 left-4 z-40 bg-white bg-opacity-90 hover:bg-opacity-100 p-3 rounded-full shadow-lg transition-all duration-200">
		<i class="fa fa-bars text-gray-800"></i>
	</button>
</div>

<script>
	class SlideoutMenu {
		private menu: HTMLElement | null;
		private panel: HTMLElement | null;
		private toggleButton: HTMLElement | null;
		private isOpen: boolean;
		private padding: number;
		private tolerance: number;

		constructor() {
			this.menu = document.getElementById('navigation-menu');
			this.panel = document.getElementById('website-content');
			this.toggleButton = document.querySelector('.toggle-button');
			this.isOpen = false;
			this.padding = 300;
			this.tolerance = 70;

			this.init();
		}

		init() {
			// Show navigation menu after page loads
			if (this.menu) this.menu.style.display = 'block';

			// Add event listeners
			if (this.toggleButton) this.toggleButton.addEventListener('click', () => this.toggle());

			// Close menu when clicking outside
			document.addEventListener('click', (e) => {
				if (this.isOpen && this.menu && this.toggleButton &&
					!this.menu.contains(e.target as Node) && !this.toggleButton.contains(e.target as Node)) {
					this.close();
				}
			});

			// Close menu on escape key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && this.isOpen) {
					this.close();
				}
			});
		}

		toggle() {
			if (this.isOpen) {
				this.close();
			} else {
				this.open();
			}
		}

		open() {
			if (this.menu) this.menu.style.transform = 'translateX(0)';
			if (this.panel) this.panel.style.transform = `translateX(${this.padding}px)`;
			if (this.toggleButton) this.toggleButton.innerHTML = '<i class="fa fa-times text-gray-800"></i>';
			this.isOpen = true;
		}

		close() {
			if (this.menu) this.menu.style.transform = 'translateX(-100%)';
			if (this.panel) this.panel.style.transform = 'translateX(0)';
			if (this.toggleButton) this.toggleButton.innerHTML = '<i class="fa fa-bars text-gray-800"></i>';
			this.isOpen = false;
		}
	}

	// Initialize when DOM is loaded
	document.addEventListener('DOMContentLoaded', () => {
		new SlideoutMenu();
	});
</script>
