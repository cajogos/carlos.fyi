---
import Layout from '../layouts/Layout.astro';

---

<Layout
	title="Get In Touch | Carlos Ferreira - All Things Developer from London"
	description="Contact Carlos Ferreira - All Things Developer from London"
	pageId="contact"
>

	<main class="contact-page">
		<h1 class="text-3xl sm:text-4xl md:text-5xl font-light text-white text-center mb-8 px-4">Oh, why hello there...</h1>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
			<div class="lg:col-span-7">
				<h2 class="text-2xl sm:text-3xl font-light text-white mb-6">Let's build things together!</h2>
				<div class="space-y-4 text-white text-sm sm:text-base">
					<p>
						I am always looking for new projects to work on. So, if have you got an idea that you would like to make it a reality,
						send me a quick email to <a href="mailto:c@rlos.rocks" class="text-link-blue hover:text-link-hover transition-colors duration-200">c@rlos.rocks</a>.
					</p>
					<p>
						As long as we have a comfortable schedule. I am more than willing to discussing and maybe even work on something new!
						Maybe grab a chocolate frappé in central London after work?
					</p>
				</div>
			</div>

			<div class="lg:col-span-1"></div>

			<div class="lg:col-span-4">
				<h2 class="text-2xl sm:text-3xl font-light text-white mb-6">Methods of contact</h2>
				<div class="space-y-4 text-white text-sm sm:text-base">
					<p>
						I am pretty much everywhere on the Interwebz! Mostly known online by the nickname of
						<strong>
							<a href="https://duckduckgo.com/?q=cajogos" target="_blank" class="text-link-blue hover:text-link-hover transition-colors duration-200">
								cajogos
							</a>
						</strong>.
					</p>

					<h3 class="text-lg sm:text-xl font-light text-white mt-8 mb-4">So you want to...</h3>

					<div class="contact-methods space-y-6">
						<div>
							<h4 class="text-base sm:text-lg font-medium text-white mb-2">
								...send me an <i class="fa-solid fa-envelope text-cajogos-blue" title="email"></i>?<br />
								<a href="mailto:c@rlos.rocks" class="text-link-blue hover:text-link-hover transition-colors duration-200">
									c@rlos.rocks
								</a>
							</h4>
						</div>

						<div>
							<h4 class="text-base sm:text-lg font-medium text-white mb-2">
								...connect with me on <i class="fa-brands fa-linkedin text-cajogos-blue" title="LinkedIn"></i>?<br />
								<a href="https://www.linkedin.com/in/cajogos" target="_blank" class="text-link-blue hover:text-link-hover transition-colors duration-200">
									Carlos Ferreira
								</a>
							</h4>
						</div>

						<div>
							<h4 class="text-base sm:text-lg font-medium text-white mb-2">
								...follow me on <i class="fa-brands fa-twitter text-cajogos-blue" title="X"></i>?<br />
								<a href="https://x.com/cajogos" target="_blank" class="text-link-blue hover:text-link-hover transition-colors duration-200">
									@cajogos
								</a>
							</h4>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

</Layout>